# Na Pista Default UI — copy to .env.local, never commit real values.
# Both values below are meant to be PUBLIC (CLAUDE.md §6/§11 — anon key +
# project URL only, never a service role key, never in this app).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Na Pista API this UI consumes — never the Platform's DB, never a
# server-only secret. The UI is one consumer among possibly many
# (ADR-008: Default UI vs Custom UI share the same API).
NEXT_PUBLIC_NA_PISTA_API_URL=http://127.0.0.1:4200/v1

# Used only to resolve which organizations the signed-in user belongs to
# (GET /v1/me) — a Platform concern (memberships), never duplicated here.
NEXT_PUBLIC_PLATFORM_API_URL=http://127.0.0.1:4000/v1

# Optional: the Última Linha account app (UL Client) where an invited team
# member accepts the invitation (`/app/invitations`). Shown to the inviter.
NEXT_PUBLIC_UL_CLIENT_URL=http://127.0.0.1:3002
